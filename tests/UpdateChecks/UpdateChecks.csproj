<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../src/Museek/Services/AppUpdateService.cs" Link="AppUpdateService.cs" />
    <Compile Remove="Fixture/**/*.cs" />
    <ProjectReference Include="Fixture/Fixture.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <Target Name="CopyInstallerFixture" AfterTargets="Build">
    <Copy SourceFiles="$(MSBuildThisFileDirectory)Fixture/bin/$(Configuration)/net10.0-windows/win-x64/MuseekUpdateFixture.exe" DestinationFiles="$(OutDir)installer-fixture.exe" />
  </Target>
</Project>
