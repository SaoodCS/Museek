<Window x:Class="Museek.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Museek updates" Width="440" SizeToContent="Height" ResizeMode="NoResize"
        Background="#1D211B" Foreground="#EDEFE8" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="13"
        WindowStartupLocation="CenterOwner" Loaded="Window_Loaded" SourceInitialized="Window_SourceInitialized"
        Closing="Window_Closing" Closed="Window_Closed">
  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <TextBlock x:Name="UpdateCurrentVersion" FontSize="12" Foreground="#A9B39F" Margin="0,0,0,14" />
    <TextBlock x:Name="UpdateStatus" Grid.Row="1" Text="Checking for updates…" FontSize="20" FontWeight="SemiBold"
               TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
    <TextBlock x:Name="UpdateDetails" Grid.Row="2" Text="Looking for the latest Museek release." TextWrapping="Wrap"
               Foreground="#C1CABC" Margin="0,10,0,18" />
    <ProgressBar x:Name="UpdateProgress" Grid.Row="3" Height="5" Minimum="0" Maximum="100"
                 Foreground="#C5F277" Background="#30352D" BorderThickness="0" IsIndeterminate="True"
                 AutomationProperties.Name="Update download progress" Margin="0,0,0,22" />
    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button x:Name="UpdateActionButton" Content="Check again" IsEnabled="False" Margin="0,0,8,0"
              Background="#C5F277" Foreground="#1D211B" IsDefault="True" Click="UpdateAction_Click" />
      <Button x:Name="UpdateCloseButton" Content="Cancel" Click="UpdateClose_Click" IsCancel="True" />
    </StackPanel>
  </Grid>
</Window>
