<Window x:Class="Museek.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Museek.Controls"
        Title="Museek" Width="570" Height="445" MinWidth="450" MinHeight="445"
        WindowStartupLocation="CenterScreen" Background="#1D211B" Foreground="#EDEFE8"
        FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="13"
        AllowDrop="True" DragOver="Window_DragOver" Drop="Window_Drop"
        PreviewKeyDown="Window_PreviewKeyDown" Loaded="Window_Loaded" Closing="Window_Closing">
  <Grid Margin="32,22,32,20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <DockPanel Grid.Row="0" LastChildFill="False">
      <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
        <Border Background="#C5F277" CornerRadius="7" Width="28" Height="28" Margin="0,0,10,0">
          <Path Data="M 8,12 L 8,19 M 12,7 L 12,21 M 16,10 L 16,18 M 20,5 L 20,16" Stroke="#20261B" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
        </Border>
        <TextBlock Text="museek" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
      </StackPanel>
      <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
        <Button x:Name="OpenButton" Content="Open file" Background="Transparent" Padding="12,8" Click="OpenButton_Click" ToolTip="Open an audio file (Ctrl+O)" AutomationProperties.Name="Open audio file" />
        <Button Content="···" FontSize="19" Padding="10,4" Background="Transparent" Click="MenuButton_Click" AutomationProperties.Name="More options">
          <Button.ContextMenu>
            <ContextMenu>
              <MenuItem Header="Choose Museek as default…" Click="DefaultApp_Click" />
              <Separator />
              <MenuItem Header="About Museek" Click="About_Click" />
            </ContextMenu>
          </Button.ContextMenu>
        </Button>
      </StackPanel>
    </DockPanel>

    <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,22,0,12">
      <TextBlock x:Name="ModeLabel" Text="YOUR AUDIO, SIMPLY." FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,0,0,9" />
      <TextBlock x:Name="SongTitle" Text="A little room for music." FontSize="25" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextAlignment="Center" Margin="0,0,0,5" AutomationProperties.Name="Song title" />
      <TextBlock x:Name="FileSubtitle" Text="Open an audio file, or drop one here." Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" TextAlignment="Center" Margin="0,0,0,20" />
      <Button x:Name="PlayButton" Width="62" Height="62" Padding="0" Background="{StaticResource Accent}" IsEnabled="False" HorizontalAlignment="Center" Click="PlayButton_Click" ToolTip="Play / pause (Space)" AutomationProperties.Name="Play">
        <Button.Template><ControlTemplate TargetType="Button"><Border x:Name="Circle" Background="{TemplateBinding Background}" CornerRadius="31"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Circle" Property="Opacity" Value="0.85" /></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Circle" Property="Opacity" Value="0.35" /></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Circle" Property="BorderBrush" Value="White" /><Setter TargetName="Circle" Property="BorderThickness" Value="2" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Button.Template>
        <Path x:Name="PlayIcon" Data="M 0,0 L 0,20 L 16,10 Z" Fill="#1D2813" Margin="4,0,0,0" />
      </Button>
    </StackPanel>

    <Grid Grid.Row="2">
      <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
      <controls:RangeSeekBar x:Name="SeekBar" IsEnabled="False" SeekRequested="SeekBar_SeekRequested" SelectionChanged="SeekBar_SelectionChanged" />
      <Grid Grid.Row="1" Margin="8,-3,8,10">
        <TextBlock x:Name="CurrentTime" Text="0:00" Foreground="{StaticResource Muted}" FontSize="11" HorizontalAlignment="Left" />
        <TextBlock x:Name="SelectionLabel" Foreground="{StaticResource Accent}" FontSize="11" HorizontalAlignment="Center" Visibility="Collapsed" />
        <TextBlock x:Name="TotalTime" Text="0:00" Foreground="{StaticResource Muted}" FontSize="11" HorizontalAlignment="Right" />
      </Grid>
    </Grid>

    <Grid Grid.Row="3" Margin="0,3,0,0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <TextBlock Text="&#xE767;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,8,0" />
        <Slider x:Name="VolumeSlider" Width="105" Minimum="0" Maximum="100" Value="75" SmallChange="1" LargeChange="10" ValueChanged="VolumeSlider_ValueChanged" AutomationProperties.Name="Volume" ToolTip="Volume" />
        <TextBlock x:Name="VolumeLabel" Text="75%" Width="36" FontSize="11" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="8,0,0,0" />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal">
        <Button x:Name="TrimButton" Content="Trim" IsEnabled="False" Click="TrimButton_Click" AutomationProperties.Name="Trim audio" />
        <Button x:Name="CancelButton" Content="Cancel" Background="Transparent" Margin="0,0,8,0" Visibility="Collapsed" Click="CancelButton_Click" />
        <Button x:Name="SaveButton" Content="Save copy" Background="{StaticResource Accent}" Foreground="#20261B" FontWeight="SemiBold" Visibility="Collapsed" Click="SaveButton_Click" AutomationProperties.Name="Save trimmed copy" />
      </StackPanel>
    </Grid>

    <StackPanel Grid.Row="4" Margin="0,14,0,0">
      <ProgressBar x:Name="ExportProgress" Height="3" Minimum="0" Maximum="1" Foreground="{StaticResource Accent}" Visibility="Collapsed" Margin="0,0,0,8" />
      <TextBlock x:Name="StatusText" Text="Local files. No library. Just listen." Foreground="{StaticResource Muted}" FontSize="11" MaxHeight="36" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" AutomationProperties.LiveSetting="Polite" />
    </StackPanel>
  </Grid>
</Window>
